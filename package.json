{
  "name": "kimorel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @kimorel/demo dev",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build": "node scripts/review-manifest.mjs --check && pnpm build:packages && pnpm --filter @kimorel/demo build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "pnpm build:packages && tsc --noEmit -p tsconfig.json && pnpm --filter @kimorel/demo typecheck",
    "test": "pnpm build:packages && vitest run && node --test scripts/*.test.mjs",
    "validate:data": "pnpm build:packages && node scripts/validate-data.mjs",
    "assets:build": "python3 pipeline/character/build.py && pnpm assets:hashes",
    "assets:qa": "node scripts/glb-qa.mjs",
    "validate:preview": "pnpm build:packages && node scripts/validate-data.mjs --preview && node scripts/review-manifest.mjs --check",
    "assets:preview": "python3 pipeline/character/preview.py && pnpm assets:hashes",
    "assets:hashes": "node scripts/review-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@kimorel/core": "workspace:*",
    "@kimorel/data": "workspace:*",
    "@kimorel/react": "workspace:*",
    "@kimorel/schemas": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "eslint": "9.39.5",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
