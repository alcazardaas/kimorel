{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "vite.browser.config.ts",
    "tests/browser/**/*.ts",
    "tests/browser/**/*.tsx"
  ]
}
